# Banco PostgreSQL (Neon, Supabase, etc.)
# Neon: pooled connection (para queries normais)
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require&pgbouncer=true"
# Neon: direct connection (para migrations/seed)
DIRECT_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"

# NextAuth
NEXTAUTH_URL="https://seu-app.vercel.app"
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"

# Microsoft 365 / Azure AD
AZURE_AD_CLIENT_ID="seu-client-id-do-azure"
AZURE_AD_CLIENT_SECRET="seu-client-secret-do-azure"
AZURE_AD_TENANT_ID="seu-tenant-id-do-azure"
